{
  "name": "dev-workflow",
  "version": "2.0.0",
  "description": "Per-project installer for the YouTrack ticket workflow — /dev-task, /dev-bug, /dev-done as Claude Code skills.",
  "type": "module",
  "bin": {
    "dev-workflow": "./bin/install.mjs"
  },
  "scripts": {
    "lint": "bash tests/lint.sh",
    "test:unit": "node --test tests/*.test.mjs",
    "test:hook": "bash tests/hook.test.sh",
    "test": "npm run lint && npm run test:unit && npm run test:hook"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "scripts",
    "hooks",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1"
  },
  "keywords": [
    "claude-code",
    "claude-code-skill",
    "youtrack",
    "workflow",
    "issue-tracker"
  ],
  "author": "Ayoub Hidri <ayoub@opkod.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayhid/claude-youtrack-workflow.git"
  },
  "homepage": "https://github.com/ayhid/claude-youtrack-workflow#readme",
  "bugs": {
    "url": "https://github.com/ayhid/claude-youtrack-workflow/issues"
  }
}
