{
  "name": "claude-dev-workflow",
  "version": "1.18.2",
  "description": "Per-project installer for the ticket-driven dev workflow — /dev-task, /dev-bug, /dev-done as Claude Code skills, against YouTrack or GitHub Issues.",
  "type": "module",
  "bin": {
    "claude-dev-workflow": "./bin/install.mjs"
  },
  "scripts": {
    "lint": "bash tests/lint.sh",
    "test:unit": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='commitlint.config.mjs' --test-reporter=lcov --test-reporter-destination=lcov.info --test-reporter=spec --test-reporter-destination=stdout tests/*.test.mjs",
    "test:hook": "bash tests/hook.test.sh && bash tests/adr-hook.test.sh && bash tests/session-hook.test.sh",
    "test": "npm run lint && npm run check:payload && npm run test:unit && npm run test:hook",
    "check:payload": "node tools/check-payload.mjs",
    "profile": "node tools/profile.mjs",
    "commit": "cz",
    "release": "semantic-release",
    "prepare": "husky || true"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "scripts",
    "hooks",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1"
  },
  "keywords": [
    "claude-code",
    "claude-code-skill",
    "youtrack",
    "github-issues",
    "workflow",
    "issue-tracker"
  ],
  "author": "Ayoub Hidri <ayoub@opkod.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayhid/claude-dev-workflow.git"
  },
  "homepage": "https://github.com/ayhid/claude-dev-workflow#readme",
  "bugs": {
    "url": "https://github.com/ayhid/claude-dev-workflow/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "inquirer": "^9.3.8",
    "semantic-release": "^25.0.9"
  }
}
