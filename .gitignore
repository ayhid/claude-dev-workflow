.DS_Store

# package-lock.json is deliberately committed: `main` is the distribution
# channel for both install paths, so CI must resolve the same dependency tree
# users get, and `npm ci` needs the lockfile to exist.

# Left over from the years this repo installed the workflow into itself (ADR
# 0008): worktree checkouts `dev.mjs start` created, and the transition log it
# appended to on every start, close and abandon. Nothing writes either any more
# — `tools/profile.mjs` still reads the log, which is why it is kept rather than
# deleted — but both are local and per-developer, and the log conflicted on
# every merge when it was not.
.worktrees/
.dev-workflow.metrics.jsonl

# coverage, produced by npm run test:coverage
lcov.info
